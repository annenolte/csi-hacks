# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
#
#   cp .env.example .env.local
#
# Restart `npm run dev` after changing anything here — Next reads env at boot.

# Anthropic API key, used by the website scraper and by Phase 3 synthesis.
# Get one at https://platform.claude.com/settings/keys
#
# Optional, and the app degrades rather than breaks without it:
#   unset -> the scraper falls back to the regex heuristics in lib/scrape/heuristics.js,
#            and /api/synthesis returns 503 with a message saying why.
#   set   -> both run through Claude, with per-fact confidence and quoted sources.
ANTHROPIC_API_KEY=

# Where the SQLite file lives. Defaults to ./call-slip.db.
# Delete the file to start the wizard over.
# DATABASE_FILE=call-slip.db
