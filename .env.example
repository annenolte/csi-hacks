# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
#
#   cp .env.example .env.local
#
# Restart `npm run dev` after changing anything here — Next reads env at boot.
# Full walkthrough for every value below: docs/SETUP.md

# --- Anthropic --------------------------------------------------------------
# Required. Drives the onboarding agent, the website reader, and document
# synthesis. Without it, onboarding cannot do its job and says so plainly rather
# than falling back to something worse.
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# --- Supabase ---------------------------------------------------------------
# Required. Project Settings -> API keys in the Supabase dashboard.
# Apply supabase/schema.sql in the SQL editor before first run.
#
# Only these two. The anon / publishable key isn't needed: the browser never
# talks to Supabase, and every table has RLS on with no policies, so that key
# can read nothing anyway.
NEXT_PUBLIC_SUPABASE_URL=

# Bypasses Row Level Security. Server-only — never add a NEXT_PUBLIC_ prefix to
# this one. That prefix ships the variable to the browser, which would hand every
# visitor full read/write access to every account.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sessions ---------------------------------------------------------------
# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
SESSION_SECRET=

# --- Google Calendar (optional) ---------------------------------------------
# Read/write calendar access, so the voice agent can check availability and book
# jobs later. Leave blank and the dashboard shows "Not connected" instead.
# Setup walkthrough: docs/SETUP.md section 3.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
